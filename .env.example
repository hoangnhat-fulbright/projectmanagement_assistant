# Sao chép thành .env rồi điền giá trị. Mọi biến đều tùy chọn khi chạy thử trên máy.

# Cổng và địa chỉ công khai của app. BASE_URL được dùng để tạo liên kết trong email.
PORT=3000
BASE_URL=http://localhost:3000

# Múi giờ dùng để hiển thị và để hiểu "thứ Sáu", "ngày mai" trong cuộc họp.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Trích xuất task bằng Claude. Không có khóa thì app chạy chế độ demo
# (luật đơn giản, chỉ để thử luồng, không dùng cho cuộc họp thật).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Ép bộ trích xuất: claude | demo
# EXTRACTOR=

# Gửi email thật qua SMTP. Để trống thì email nằm ở trang /outbox thay vì được gửi đi.
# Ví dụ: smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Meeting Commitments <no-reply@example.com>"

# Mật khẩu cho các trang của người chủ trì (đăng nhập với tên "admin").
# Bắt buộc đặt khi đưa app lên mạng. Trang xác nhận /a/... luôn công khai.
APP_PASSWORD=

# Nơi lưu database (PGlite: Postgres chạy ngay trong tiến trình Node).
DATA_DIR=./data/pg

# Nhắc việc theo lịch. Các con số dưới đây là giá trị mặc định; chỉ cần đặt khi muốn thử giá trị khác.
# NUDGE_LEAD_MINUTES=120                 # báo trước tối thiểu của nhắc chuẩn bị
# NUDGE_MIN_GAP_MINUTES=15               # độ dài tối thiểu của một khoảng trống
# NUDGE_BUFFER_MINUTES=5                 # khoảng trống bắt đầu sau cuộc họp trước từng này phút
# NUDGE_GAP_WINDOW_HOURS=48              # nhắc khoảng trống chỉ trong từng này giờ trước hạn
# NUDGE_MAX_PER_DAY=3                    # số lần nhắc tối đa mỗi người mỗi ngày
# NUDGE_MIN_SPACING_MINUTES=90           # khoảng cách tối thiểu giữa hai lần nhắc
# NUDGE_QUIET_AFTER_COMMIT_MINUTES=30    # không nhắc ngay sau khi vừa xác nhận; đặt 0 khi thử
